# Optional public site origin for absolute metadata (OG images, canonicals).
# Defaults to http://localhost:3000 in development and https://cloudflare-experiments.com in production.
# NEXT_PUBLIC_SITE_URL=https://cloudflare-experiments.com

# Traks site key from https://traks.dev (e.g. pb_live_...).
# Required for analytics. Set in `.env.local` for local builds.
# For Cloudflare Workers Builds, add the same name as a **Build variable**
# (Settings → Builds) — CI does not use `.env.local`, and a missing value
# used to 500 every HTML page via `next-traks: site is required`.
NEXT_PUBLIC_TRAKS_SITE=

# Optional Buy Me a Coffee page URL shown in the navbar.
# Set in `.env.local` for local builds, and as a Workers Builds variable for deploy.
# NEXT_PUBLIC_BUY_ME_A_COFFEE_URL=https://buymeacoffee.com/shrinathsnayak
