# Optional public site origin for absolute metadata (OG images, canonicals).
# Defaults to http://localhost:3000 in development and https://cloudflare-experiments.com in production.
# NEXT_PUBLIC_SITE_URL=https://cloudflare-experiments.com

# Traks site key from https://traks.dev (e.g. pb_live_...).
# Required for analytics; set in `.env.local` for dev and as a build-time var for production deploys.
NEXT_PUBLIC_TRAKS_SITE=
