{
  "name": "event-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "pipelines": [
    {
      "binding": "PIPELINE",
      "pipeline": "events-pipeline"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVENTS",
      "bucket_name": "event-pipeline-events"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
